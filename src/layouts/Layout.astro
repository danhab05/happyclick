---
interface Props { active: '/' | '/kit' | '/guides'; }
const { active } = Astro.props;
const links = [
  { href: '/', label: 'Accueil' },
  { href: '/kit', label: 'Le KIT' },
  { href: '/guides', label: 'Guides' },
  { href: 'https://gate.wp.telecom-sudparis.eu/gate-projets/happy-click/', label: '2024-2025' },
  { href: 'https://www.telecom-sudparis.eu/ecole/gestion-apprentissage-travail-en-equipe/', label: "Qu'est-ce qu'un GATE® ?" },
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Happy Click - GATE 2025/2026</title>
    <link rel="stylesheet" href="/style.css" />
    <link rel="icon" type="image/png" href="/assets/icons/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/assets/icons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header>
      <div class="header_name">
        <img src="/assets/images/LogoBasseRes.png" id="header_logo" width="444" height="463" alt="" />
        <span class="header-title">Happy Click</span>
      </div>
      <nav aria-label="Navigation principale">
        {links.map(({ href, label }) => (
          <a href={href} class:list={{ highlighted: href === active }}
             aria-current={href === active ? 'page' : undefined}
             target={href.startsWith('https:') ? '_blank' : undefined}
             rel={href.startsWith('https:') ? 'noopener noreferrer' : undefined}>{label}</a>
        ))}
      </nav>
    </header>
    <slot />
    <footer><span>Happy Click - Campagne 2025-2026</span></footer>
  </body>
</html>
