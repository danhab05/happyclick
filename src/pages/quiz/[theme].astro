---
import Layout from '../../layouts/Layout.astro';
import QuizComingSoon from '../../components/QuizComingSoon.astro';
import QuizGame from '../../components/QuizGame.astro';
import allQuestions from '../../data/quiz.json';
import { quizzesEnabled } from '../../lib/quiz-availability.mjs';
import '../../styles/jeu-imprime.css';

export function getStaticPaths() {
  const themes = [
    ['comportements', 'Les bons réflexes', 'reflexes'],
    ['sante', 'Trouver son équilibre', 'equilibre'],
    ['ecologie', 'Derrière nos écrans', 'planete'],
    ['tout', 'Toutes les cartes', 'tout'],
  ] as const;
  return themes.map(([theme, title, picture]) => ({
    params: { theme },
    props: { theme, title, picture, questions: allQuestions.filter(q => theme === 'tout' || q.theme === theme) },
  }));
}

const { theme, title, picture, questions } = Astro.props;
---
<Layout active="/quiz" title={title}>
  {quizzesEnabled ? <QuizGame {theme} {title} {picture} {questions} /> : (
    <section class="game-index" aria-labelledby="quiz-title">
      <div class="casebook quiz-unavailable">
        <QuizComingSoon />
        <h1 id="quiz-title">{title}</h1>
        <p>En attendant le quiz en ligne, tu peux jouer avec les cartes à imprimer.</p>
        <div class="actions">
          <a class="button" href="/resources/kit/activite_cartes_a_imprimer.pdf">Imprimer les cartes (PDF)</a>
          <a href="/quiz">Voir les quatre quiz</a>
        </div>
      </div>
    </section>
  )}
</Layout>
