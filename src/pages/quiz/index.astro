---
import Layout from '../../layouts/Layout.astro';
import ThemeCards from '../../components/ThemeCards.astro';
import { quizzesEnabled } from '../../lib/quiz-availability.mjs';
import '../../styles/jeu-imprime.css';
---
<Layout active="/quiz" title="Les paquets de quiz">
  <div class="game-index">
    <section class="casebook" aria-labelledby="quiz-title">
      <header class="casebook-title">
        <h1 id="quiz-title">Les quiz</h1>
        <p>{quizzesEnabled ? 'Choisissez un paquet. Jouez seul, en famille ou en classe par groupes de 4 à 6.' : 'Les quiz en ligne sont à venir. Les cartes sont disponibles à imprimer.'}</p>
      </header>
      <ThemeCards />
    </section>
    <section class="case-rules" aria-labelledby="how-title">
      <h2 id="how-title">{quizzesEnabled ? 'La règle du jeu' : 'Les cartes à imprimer'}</h2>
      <div><p>{quizzesEnabled ? 'Cochez une ou plusieurs réponses, puis retournez la carte. Chaque corrigé propose une question à discuter. Une carte entièrement juste vaut un point.' : 'Le PDF réunit les 29 cartes et leurs corrigés pour jouer en famille ou en classe.'}</p>
      <a href="/resources/kit/activite_cartes_a_imprimer.pdf">Imprimer les cartes du jeu <small>(PDF, 16 pages)</small></a></div>
    </section>
  </div>
</Layout>
