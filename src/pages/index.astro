---
import Layout from '../layouts/Layout.astro';
import ThemeCards from '../components/ThemeCards.astro';
import Doodle from '../components/Doodle.astro';
import games from '../data/roles.json';
const pictures = { addiction: 'addiction', cyberharcelement: 'cyberharcelement', desinformation: 'desinformation' } as const;
---
<Layout active="/">
  <div class="wrap">
    <section class="board home-board" aria-labelledby="home-title">
      <div class="board-intro">
        <h1 id="home-title">Tire une carte, on en parle&nbsp;!</h1>
        <p>Choisis un paquet, réponds, puis retourne la carte.</p>
      </div>
      <ThemeCards />
      <a class="board-all" href="/quiz/tout"><Doodle name="tout" size={40} />Les 29 cartes mélangées</a>
    </section>
  </div>

  <section class="wrap section" aria-labelledby="games-title">
    <div class="home-section-head">
      <h2 id="games-title">Change de place</h2>
      <p>Trois histoires à jouer à six. Chacun reçoit un personnage, puis on discute après chaque scène.</p>
    </div>
    <ul class="scenes">
      {games.map(g => <li><a class="scene" href={`/kit/roles/${g.slug}`}><Doodle name={pictures[g.slug as keyof typeof pictures]} size={84} /><span><strong>{g.title}</strong><span>6 personnages, 4 scènes</span></span></a></li>)}
    </ul>
    <div class="mirror">
      <Doodle name="usages" size={88} />
      <div><h2>Mes écrans et moi</h2><p>Onze petites questions pour regarder tes habitudes. Rien n’est noté, rien n’est envoyé.</p></div>
      <a class="button secondary" href="/mes-usages">Répondre aux questions</a>
    </div>
  </section>

  <section class="grownups section" aria-labelledby="grownups-title">
    <div class="wrap grownups-grid">
      <div class="grownups-intro">
        <h2 id="grownups-title">Pour les adultes qui accompagnent</h2>
        <p>Parent ou enseignant, tu trouveras ici comment jouer avec les enfants, les documents à imprimer et des repères pour en parler.</p>
        <ul class="reassure">
          <li>Pas de compte, rien n’est enregistré.</li>
          <li>Pas de score : le but est de discuter.</li>
          <li>Chaque réponse renvoie à la page du document d’origine.</li>
        </ul>
      </div>
      <ul class="paths">
        <li><a class="path" href="/faq#famille"><Doodle name="maison" size={48} /><strong>Jouer à la maison</strong><span>Ouvrir une carte avec son enfant et écouter son avis.</span></a></li>
        <li><a class="path" href="/kit"><Doodle name="classe" size={48} /><strong>Animer une séance en classe</strong><span>Cartes à imprimer, jeux de rôles et questionnaires.</span></a></li>
        <li><a class="path" href="/guides"><Doodle name="livre" size={48} /><strong>Lire les guides pour les parents</strong><span>Une étude et un guide de 2021, résumés chapitre par chapitre.</span></a></li>
        <li><a class="path" href="/faq"><Doodle name="carnet" size={48} /><strong>Questions fréquentes</strong><span>Pour qui, quels PDF, que deviennent les réponses.</span></a></li>
      </ul>
    </div>
  </section>

  <section class="wrap section compact">
    <div class="edition-note">
      <img src="/assets/2027/logo-128.png" width="128" height="138" alt="Logo Happy Click 2027 : un cœur, deux mains et un curseur" loading="lazy" />
      <p>Happy Click 2027 est préparé par une nouvelle équipe, avec deux versions du jeu « Écrans et équilibre ». <a class="text-link" href="/projet-2027">Découvrir le projet et l’équipe</a></p>
    </div>
  </section>
</Layout>
