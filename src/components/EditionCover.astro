---
import Doodle from './Doodle.astro';
interface Props {
  kind: 'kit' | 'guides' | 'projet' | 'faq' | 'roles' | 'carnet' | 'usages';
  illustration?: 'addiction' | 'cyberharcelement' | 'desinformation';
}
const { kind, illustration = 'addiction' } = Astro.props;
---
<header class={`edition-cover cover-${kind}`}>
  <div class="wrap edition-cover-inner">
    <div class="edition-cover-copy"><slot /></div>
    <div class="edition-art" aria-hidden="true">
      {kind === 'kit' && <>
        <img class="plate rear" src="/assets/previews/carte-equilibre.webp" width="800" height="566" alt="" />
        <img class="plate front" src="/assets/previews/carte-reflexes.webp" width="800" height="566" alt="" />
      </>}
      {kind === 'guides' && <>
        <img class="plate rear" src="/assets/previews/guide-jeunes.jpg" width="424" height="600" alt="" />
        <img class="plate front" src="/assets/previews/etude-parents.jpg" width="424" height="600" alt="" />
      </>}
      {kind === 'projet' && <div class="print-year"><span>20</span><span>27</span></div>}
      {kind === 'faq' && <div class="question-print">?</div>}
      {kind === 'roles' && <div class="role-sheet"><Doodle name={illustration} size={150} /><span>Jeu de rôles</span></div>}
      {(kind === 'carnet' || kind === 'usages') && <div class="notebook-sheet"><Doodle name={kind === 'carnet' ? 'carnet' : 'usages'} size={150} /></div>}
    </div>
  </div>
</header>
