---
import Doodle from './Doodle.astro';
import questions from '../data/quiz.json';

const decks = [
  { slug: 'comportements', title: 'Les bons réflexes', icon: 'reflexes', sample: 'q01' },
  { slug: 'sante', title: 'Trouver son équilibre', icon: 'equilibre', sample: 'q11' },
  { slug: 'ecologie', title: 'Derrière nos écrans', icon: 'planete', sample: 'q20' },
] as const;
---
<section class="home-decks" aria-labelledby="home-decks-title">
  <div class="wrap deck-directory">
    <div class="deck-directory-intro">
      <h2 id="home-decks-title">Les cartes du quiz</h2>
      <p>29 questions, trois thèmes. Choisissez un paquet pour jouer.</p>
      <a class="kit-link" href="/quiz">Voir tous les quiz</a>
    </div>
    <ul class="deck-directory-list">
      {decks.map(deck => <li>
        <a href={`/quiz/${deck.slug}`}>
          <Doodle name={deck.icon} size={54} />
          <span><strong>{deck.title}</strong><span class="card-excerpt">{questions.find(q => q.id === deck.sample)!.question}</span></span>
          <span class="deck-arrow" aria-hidden="true">→</span>
        </a>
      </li>)}
    </ul>
  </div>
</section>
