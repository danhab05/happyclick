---
import Doodle from './Doodle.astro';
interface Props { class?: string; }
const { class: className } = Astro.props;
// Three decks of the printed quiz, named as on the cards; counts follow src/data/quiz.json.
const decks = [
 { slug: 'comportements', count: 10, name: 'Les bons réflexes', topic: 'Mots de passe, photos, messages.', picture: 'reflexes' },
 { slug: 'sante', count: 8, name: 'Trouver son équilibre', topic: 'Écrans, sommeil, temps pour soi.', picture: 'equilibre' },
 { slug: 'ecologie', count: 11, name: 'Derrière nos écrans', topic: 'D’où viennent nos appareils ?', picture: 'planete' },
] as const;
---
<ul class:list={['decks', className]} aria-label="Les trois paquets de cartes">
  {decks.map(d => <li class={`deck-${d.slug}`}><a class="deck" href={`/quiz/${d.slug}`}>
    <span class="deck-picture"><Doodle name={d.picture} size={88} /></span>
    <span class="deck-name">{d.name}</span>
    <span class="deck-topic">{d.topic}</span>
    <span class="deck-count"><span>{d.count} cartes</span></span>
  </a></li>)}
</ul>
