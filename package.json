{
  "name": "happyclick-astro-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0 --port 4321",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0 --port 4321",
    "verify": "python3 scripts/verify.py",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "astro": "7.4.12"
  },
  "devDependencies": {
    "linkedom": "0.18.15",
    "node": "22.23.4"
  }
}
